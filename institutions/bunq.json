{
  "version": 1,
  "kind": "records",
  "type": "bank",
  "records": {
    "institution": "bunq",
    "aliases": [],
    "mt940": {
      "version": 1,
      "institution": "bunq",
      "name": "Bunq",
      "aliases": [],
      "format": "bunq_mt940",
      "companion_format": "bunq_csv",
      "kind": "bunq-transaction",
      "payload_tag": "bunq-v1",
      "account_prefix": "current-",
      "recognizer_prefix": "BUNQ",
      "matching_policy": "bunq-csv-v1",
      "remittance_marker": "/REMI/",
      "name_marker": "/NAME/",
      "counterparty_marker": "/IBAN/",
      "entry_pattern": "^([0-9]{6})([0-9]{4})([CD])([0-9]+,[0-9]*)(N[A-Z]{3})NONREF$",
      "header": [
        "Date",
        "Interest Date",
        "Amount",
        "Account",
        "Counterparty",
        "Name",
        "Description"
      ],
      "columns": {
        "booked_on": "Date",
        "value_on": "Interest Date",
        "amount": "Amount",
        "account_id": "Account",
        "counterparty": "Counterparty",
        "name": "Name",
        "description": "Description"
      },
      "metadata_prefix": "bunq"
    },
    "csv": {
      "format": "fin-csv-converter",
      "version": 1,
      "institution": "bunq",
      "institution_type": "bank",
      "decimal": "comma",
      "header": [
        "Date",
        "Interest Date",
        "Amount",
        "Account",
        "Counterparty",
        "Name",
        "Description"
      ],
      "observation": true,
      "account": {
        "id": "{Account}",
        "bank": "bunq",
        "currency": {
          "code": "EUR"
        }
      },
      "occurred": {
        "column": "Date",
        "layout": "iso-date"
      },
      "value_on": {
        "column": "Interest Date",
        "layout": "iso-date"
      },
      "cases": [
        {
          "movements": [
            {
              "role": "primary",
              "quantity": {
                "column": "Amount"
              },
              "commodity": {
                "code": "EUR"
              }
            }
          ]
        }
      ],
      "descriptions": [
        "Description"
      ],
      "counterparty_name": [
        "Name"
      ],
      "counterparty_iban": "Counterparty",
      "journal_tags": {
        "bunq-counterparty": "Counterparty"
      },
      "require": [
        {
          "column": "Amount",
          "matches": "^-?[0-9][^,.]*,[0-9]{2}$"
        },
        {
          "column": "Account",
          "matches": "^\\S+$"
        }
      ]
    }
  },
  "rules": []
}
