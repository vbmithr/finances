{
  "version": 1,
  "kind": "ofx-csv",
  "type": "bank",
  "ofx": {
    "institution": "boursobank",
    "aliases": [
      "boursorama",
      "bourso"
    ],
    "companion_format": "csv",
    "matching_policy": "bourso-csv-exact-v1",
    "snapshot": false,
    "layout": {
      "version": 1,
      "name": "BoursoBank",
      "header": [
        "Date Opération",
        "Date Valeur",
        "Libellé",
        "Libellé Suggéré",
        "Catégorie",
        "Catégorie Parente",
        "Solde",
        "Commentaire",
        "Numéro Compte",
        "Libellé Compte",
        "Solde",
        "Pointage"
      ],
      "separator": ";",
      "currency": null,
      "trim_header": true,
      "trim_cells": true,
      "skip_blank_rows": true,
      "account_id": 8,
      "booked_on": 0,
      "value_on": 1,
      "amount": 6,
      "description": 2,
      "suggested_description": 3,
      "category": 4,
      "parent_category": 5,
      "comment": 7,
      "account_label": 9,
      "reported_balance": 10,
      "pointage": 11,
      "date_format": "iso",
      "amount_format": "comma",
      "balance_format": "dot"
    }
  },
  "rules": [
    {
      "name": "boursobank-default-01",
      "pattern": "^(?:Relevé différé Carte |Relev\\{ diff\\{r\\{ Carte ).+",
      "case_sensitive": true,
      "priority": 0,
      "action": "type",
      "target": "card-settlement"
    },
    {
      "name": "boursobank-default-02",
      "pattern": "^(?:PAIEMENT\\s+CARTE|AVOIR)(?:\\s|$)",
      "case_sensitive": false,
      "priority": 1,
      "action": "type",
      "target": "card"
    },
    {
      "name": "boursobank-default-03",
      "pattern": "^CARTE(?:\\s|$)",
      "case_sensitive": false,
      "priority": 2,
      "account_type": "CREDITCRD",
      "action": "type",
      "target": "card"
    },
    {
      "name": "boursobank-default-04",
      "pattern": "^(?:VIR|VIREMENT)(?:\\s|$)",
      "case_sensitive": false,
      "priority": 3,
      "action": "type",
      "target": "transfer"
    },
    {
      "name": "boursobank-default-05",
      "pattern": "^(?:PRLV|PRELEVEMENT)(?:\\s|$)",
      "case_sensitive": false,
      "priority": 4,
      "action": "type",
      "target": "direct-debit"
    },
    {
      "name": "boursobank-default-06",
      "pattern": "^(?:RETRAIT|ANNUL\\s+RETRAIT\\s+DAB)(?:\\s|$)",
      "case_sensitive": false,
      "priority": 5,
      "action": "type",
      "target": "withdrawal"
    },
    {
      "name": "boursobank-default-07",
      "pattern": "^(?:\\*INTERETS|INTERETS|\\*INTÉRÊTS|INTÉRÊTS|\\*INTER\\.BRUTS|\\*INT\\s+DEB)(?:\\s|$)",
      "case_sensitive": false,
      "priority": 6,
      "action": "type",
      "target": "interest"
    },
    {
      "name": "boursobank-default-08",
      "pattern": "^REM\\s+CHQ(?:\\s|$)",
      "case_sensitive": false,
      "priority": 7,
      "action": "type",
      "target": "deposit"
    },
    {
      "name": "boursobank-default-09",
      "pattern": "^CHQ\\.(?:\\s|$)",
      "case_sensitive": false,
      "priority": 8,
      "action": "type",
      "target": "cheque"
    },
    {
      "name": "boursobank-default-10",
      "pattern": "^(?:\\*CION\\s+CB|\\*FRAIS\\s+CB|\\*RETROC\\s+\\*FRAIS\\s+CB)(?:\\s|$)",
      "case_sensitive": false,
      "priority": 9,
      "action": "type",
      "target": "fee"
    },
    {
      "name": "boursobank-card-reference",
      "pattern": "^(?:Relevé différé Carte |Relev\\{ diff\\{r\\{ Carte )([\\s\\S]+)$",
      "case_sensitive": true,
      "priority": 100,
      "action": "card-reference",
      "target": "card-reference"
    },
    {
      "name": "boursobank-withdrawal-reversal",
      "pattern": "^ANNUL RETRAIT DAB ",
      "case_sensitive": false,
      "priority": 100,
      "action": "withdrawal-reversal",
      "target": "withdrawal-reversal"
    }
  ]
}
