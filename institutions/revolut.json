{
  "version": 1,
  "kind": "running-csv",
  "running": {
    "version": 1,
    "institution": "revolut",
    "name": "Revolut",
    "aliases": [],
    "format": "revolut_csv",
    "kind": "revolut-transaction",
    "payload_tag": "revolut-v1",
    "account_prefix": "current-",
    "header": [
      "Type",
      "Product",
      "Started Date",
      "Completed Date",
      "Description",
      "Amount",
      "Fee",
      "Currency",
      "State",
      "Balance"
    ],
    "columns": {
      "type": "Type",
      "product": "Product",
      "started": "Started Date",
      "completed": "Completed Date",
      "description": "Description",
      "amount": "Amount",
      "fee": "Fee",
      "currency": "Currency",
      "state": "State",
      "balance": "Balance"
    },
    "product_value": "Current",
    "completed_value": "COMPLETED",
    "reverted_value": "REVERTED"
  },
  "rules": [
    {
      "name": "revolut-reported-card-payment",
      "pattern": "^Card Payment$",
      "case_sensitive": true,
      "priority": 0,
      "action": "reported-type",
      "target": "card"
    },
    {
      "name": "revolut-reported-card-refund",
      "pattern": "^Card Refund$",
      "case_sensitive": true,
      "priority": 1,
      "action": "reported-type",
      "target": "card"
    },
    {
      "name": "revolut-reported-deposit",
      "pattern": "^Deposit$",
      "case_sensitive": true,
      "priority": 2,
      "action": "reported-type",
      "target": "deposit"
    },
    {
      "name": "revolut-reported-transfer",
      "pattern": "^Transfer$",
      "case_sensitive": true,
      "priority": 3,
      "action": "reported-type",
      "target": "transfer"
    },
    {
      "name": "revolut-reported-atm",
      "pattern": "^ATM$",
      "case_sensitive": true,
      "priority": 4,
      "action": "reported-type",
      "target": "withdrawal"
    },
    {
      "name": "revolut-reported-charge",
      "pattern": "^Charge$",
      "case_sensitive": true,
      "priority": 5,
      "action": "reported-type",
      "target": "fee"
    },
    {
      "name": "revolut-reported-other",
      "pattern": ".+",
      "case_sensitive": true,
      "priority": 100,
      "action": "reported-other",
      "target": "revolut:"
    }
  ]
}
