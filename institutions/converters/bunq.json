{
  "format": "fin-csv-converter",
  "version": 1,
  "institution": "bunq",
  "institution_type": "bank",
  "decimal": "comma",
  "header": [
    "Date",
    "Interest Date",
    "Amount",
    "Account",
    "Counterparty",
    "Name",
    "Description"
  ],
  "observation": true,
  "account": {
    "id": "{Account}",
    "bank": "bunq",
    "currency": {
      "code": "EUR"
    }
  },
  "occurred": {
    "column": "Date",
    "layout": "iso-date"
  },
  "value_on": {
    "column": "Interest Date",
    "layout": "iso-date"
  },
  "cases": [
    {
      "movements": [
        {
          "role": "primary",
          "quantity": {
            "column": "Amount"
          },
          "commodity": {
            "code": "EUR"
          }
        }
      ]
    }
  ],
  "descriptions": [
    "Description"
  ],
  "counterparty_name": [
    "Name"
  ],
  "counterparty_iban": "Counterparty"
}
