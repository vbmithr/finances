{
  "format": "fin-csv-converter",
  "version": 1,
  "institution": "wise",
  "institution_type": "bank",
  "header": [
    "TransferWise ID",
    "Date",
    "Date Time",
    "Amount",
    "Currency",
    "Description",
    "Payment Reference",
    "Running Balance",
    "Exchange From",
    "Exchange To",
    "Exchange Rate",
    "Payer Name",
    "Payee Name",
    "Payee Account Number",
    "Merchant",
    "Card Last Four Digits",
    "Card Holder Full Name",
    "Attachment",
    "Note",
    "Total fees",
    "Exchange To Amount",
    "Transaction Type",
    "Transaction Details Type"
  ],
  "observation": true,
  "account": {
    "id": "balance-{Currency}",
    "bank": "wise",
    "currency": {
      "fiat": "Currency"
    }
  },
  "id": {
    "columns": [
      "@reference",
      "Date Time",
      "Transaction Type"
    ]
  },
  "occurred": {
    "column": "Date",
    "layout": "day-first"
  },
  "cases": [
    {
      "movements": [
        {
          "role": "primary",
          "quantity": {
            "column": "Amount"
          },
          "commodity": {
            "fiat": "Currency"
          }
        }
      ]
    }
  ],
  "descriptions": [
    "Description",
    "Merchant"
  ],
  "counterparty_name": [
    "Payee Name",
    "Payer Name"
  ],
  "counterparty_iban": "Payee Account Number",
  "references": {
    "servicer": "TransferWise ID",
    "normalize_servicer": {
      "prefix": "BALANCE_CASHBACK-",
      "description": "cashback",
      "length": 32
    },
    "description_column": "Merchant",
    "payment": "Payment Reference"
  },
  "exchange": {
    "source": {
      "column": "Exchange From"
    },
    "target": {
      "column": "Exchange To"
    },
    "rate": "Exchange Rate",
    "target_quantity": "Exchange To Amount"
  },
  "balance_after": "Running Balance"
}
