{
  "version": 1,
  "kind": "records",
  "type": "bank",
  "records": {
    "institution": "wise",
    "aliases": [],
    "camt": {
      "version": 1,
      "institution": "wise",
      "namespace": "urn:iso:std:iso:20022:tech:xsd:camt.053.001.10",
      "servicer_contains": "wise",
      "account_type_prefix": "balance-",
      "event_kind": "wise-transaction",
      "payload_tag": "wise-camt-v1",
      "reference_field": "proprietary-code",
      "reference_normalization": {
        "prefix": "BALANCE_CASHBACK-",
        "description": "cashback",
        "length": 32
      },
      "operation_group": {
        "reference_prefix": "BALANCE-",
        "linked_prefix": "FEE-"
      }
    },
    "csv": {
      "format": "fin-csv-converter",
      "version": 1,
      "institution": "wise",
      "institution_type": "bank",
      "header": [
        "TransferWise ID",
        "Date",
        "Date Time",
        "Amount",
        "Currency",
        "Description",
        "Payment Reference",
        "Running Balance",
        "Exchange From",
        "Exchange To",
        "Exchange Rate",
        "Payer Name",
        "Payee Name",
        "Payee Account Number",
        "Merchant",
        "Card Last Four Digits",
        "Card Holder Full Name",
        "Attachment",
        "Note",
        "Total fees",
        "Exchange To Amount",
        "Transaction Type",
        "Transaction Details Type"
      ],
      "observation": true,
      "account": {
        "id": "balance-{Currency}",
        "bank": "wise",
        "currency": {
          "fiat": "Currency"
        }
      },
      "id": {
        "columns": [
          "@reference",
          "Date Time",
          "Transaction Type"
        ]
      },
      "occurred": {
        "column": "Date",
        "layout": "day-first"
      },
      "cases": [
        {
          "movements": [
            {
              "role": "primary",
              "quantity": {
                "column": "Amount"
              },
              "commodity": {
                "fiat": "Currency"
              }
            }
          ]
        }
      ],
      "descriptions": [
        "Description",
        "Merchant"
      ],
      "counterparty_name": [
        "Payee Name",
        "Payer Name"
      ],
      "counterparty_iban": "Payee Account Number",
      "references": {
        "servicer": "TransferWise ID",
        "normalize_servicer": {
          "prefix": "BALANCE_CASHBACK-",
          "description": "cashback",
          "length": 32
        },
        "description_column": "Merchant",
        "payment": "Payment Reference"
      },
      "exchange": {
        "source": {
          "column": "Exchange From"
        },
        "target": {
          "column": "Exchange To"
        },
        "rate": "Exchange Rate",
        "target_quantity": "Exchange To Amount"
      },
      "balance_after": "Running Balance",
      "journal_tags": {
        "wise-merchant": "Merchant",
        "wise-payment-reference": "Payment Reference",
        "wise-reported-fees": "Total fees"
      },
      "journal_description": "Merchant",
      "conflict_columns": [
        "Total fees",
        "Exchange From",
        "Exchange To",
        "Exchange Rate",
        "Exchange To Amount"
      ],
      "require": [
        {
          "column": "Transaction Type",
          "in": [
            "DEBIT",
            "CREDIT"
          ]
        },
        {
          "column": "TransferWise ID",
          "filled": true
        },
        {
          "column": "Date Time",
          "matches": "^[0-9]{2}-[0-9]{2}-[0-9]{4} [0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}$"
        },
        {
          "column": "Date",
          "prefix_of": "Date Time"
        },
        {
          "column": "Amount",
          "matches": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        {
          "column": "Running Balance",
          "matches": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        {
          "column": "Total fees",
          "matches": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        {
          "when": [
            {
              "column": "Transaction Type",
              "in": [
                "DEBIT"
              ]
            }
          ],
          "column": "Amount",
          "sign": "not-positive"
        },
        {
          "when": [
            {
              "column": "Transaction Type",
              "in": [
                "CREDIT"
              ]
            }
          ],
          "column": "Amount",
          "sign": "not-negative"
        }
      ]
    },
    "stored_formats": [
      "wise"
    ]
  },
  "rules": [
    {
      "name": "wise-id-fee",
      "pattern": "^FEE-",
      "case_sensitive": true,
      "priority": -100,
      "action": "type",
      "target": "fee",
      "field": "TransferWise ID"
    },
    {
      "name": "wise-id-cashback",
      "pattern": "^BALANCE_CASHBACK-",
      "case_sensitive": true,
      "priority": -99,
      "action": "type",
      "target": "interest",
      "field": "TransferWise ID"
    },
    {
      "name": "wise-reported-card",
      "pattern": "^CARD$",
      "case_sensitive": true,
      "priority": 0,
      "action": "type",
      "target": "card",
      "field": "Transaction Details Type"
    },
    {
      "name": "wise-reported-transfer",
      "pattern": "^TRANSFER$",
      "case_sensitive": true,
      "priority": 1,
      "action": "type",
      "target": "transfer",
      "field": "Transaction Details Type"
    },
    {
      "name": "wise-reported-conversion",
      "pattern": "^CONVERSION$",
      "case_sensitive": true,
      "priority": 2,
      "action": "type",
      "target": "conversion",
      "field": "Transaction Details Type"
    },
    {
      "name": "wise-reported-direct-debit",
      "pattern": "^DIRECT_DEBIT$",
      "case_sensitive": true,
      "priority": 3,
      "action": "type",
      "target": "direct-debit",
      "field": "Transaction Details Type"
    },
    {
      "name": "wise-reported-deposit",
      "pattern": "^DEPOSIT$",
      "case_sensitive": true,
      "priority": 4,
      "action": "type",
      "target": "deposit",
      "field": "Transaction Details Type"
    },
    {
      "name": "wise-reported-money-added",
      "pattern": "^MONEY_ADDED$",
      "case_sensitive": true,
      "priority": 6,
      "action": "type",
      "target": "deposit",
      "field": "Transaction Details Type"
    },
    {
      "name": "wise-reported-other",
      "pattern": ".+",
      "case_sensitive": true,
      "priority": 100,
      "action": "type",
      "target": "wise:{value}",
      "field": "Transaction Details Type"
    }
  ]
}
