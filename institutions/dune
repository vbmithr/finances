(include_subdirs unqualified)

; Shared source parsers live under formats and compile into this library.

(copy_files ../formats/statement/*.ml)

(copy_files ../formats/statement/*.mli)

; Bundled institutions are one definition each: source profile and default rules.

(rule
 (targets bundled_definitions.ml)
 (deps
  boursobank.toml
  wise.toml
  revolut.toml
  bunq.toml
  cdc.toml
  kraken.toml
  fdm.toml
  ethereum.toml
  polygon.toml
  lua/boursobank.lua
  lua/bunq.lua
  lua/cdc.lua
  csv/ethereum-1.json
  csv/ethereum-2.json
  lua/fdm.lua
  csv/kraken.json
  csv/polygon-1.json
  csv/polygon-2.json
  lua/revolut.lua
  csv/wise.json
  companion_example.json)
 (action
  (write-file
   %{targets}
   "let boursobank = {fin|%{read:boursobank.toml}|fin}\nlet wise = {fin|%{read:wise.toml}|fin}\nlet revolut = {fin|%{read:revolut.toml}|fin}\nlet bunq = {fin|%{read:bunq.toml}|fin}\nlet cdc = {fin|%{read:cdc.toml}|fin}\nlet kraken = {fin|%{read:kraken.toml}|fin}\nlet fdm = {fin|%{read:fdm.toml}|fin}\nlet ethereum = {fin|%{read:ethereum.toml}|fin}\nlet polygon = {fin|%{read:polygon.toml}|fin}\nlet csv = [\n  \"lua/boursobank.lua\", {fin|%{read:lua/boursobank.lua}|fin};\n  \"lua/bunq.lua\", {fin|%{read:lua/bunq.lua}|fin};\n  \"lua/cdc.lua\", {fin|%{read:lua/cdc.lua}|fin};\n  \"csv/ethereum-1.json\", {fin|%{read:csv/ethereum-1.json}|fin};\n  \"csv/ethereum-2.json\", {fin|%{read:csv/ethereum-2.json}|fin};\n  \"lua/fdm.lua\", {fin|%{read:lua/fdm.lua}|fin};\n  \"csv/kraken.json\", {fin|%{read:csv/kraken.json}|fin};\n  \"csv/polygon-1.json\", {fin|%{read:csv/polygon-1.json}|fin};\n  \"csv/polygon-2.json\", {fin|%{read:csv/polygon-2.json}|fin};\n  \"lua/revolut.lua\", {fin|%{read:lua/revolut.lua}|fin};\n  \"csv/wise.json\", {fin|%{read:csv/wise.json}|fin};\n]\nlet companion_example = {fin|%{read:companion_example.json}|fin}\n")))

; Adapters are pure: no Rel or SQLite dependency, enforced here.

(library
 (name finances_institutions)
 (public_name finances.institutions)
 (flags
  (:standard -open Finances_core))
 (libraries
  finances.core
  iso4217
  ofx
  camt
  mt940
  base
  jsont
  nox-toml
  iban
  lua-ml
  xmlm
  re
  digestif
  csv)
 (preprocess
  (pps ppx_sexp_conv ppx_compare ppx_let)))
