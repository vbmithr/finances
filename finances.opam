opam-version: "2.0"
synopsis: "Personal accounting and portfolio tracking"
maintainer: "Vincent Bernardoff"
authors: "Vincent Bernardoff"
license: "ISC"
homepage: "https://github.com/vbmithr/finances"
bug-reports: "https://github.com/vbmithr/finances/issues"
dev-repo: "git+https://github.com/vbmithr/finances.git"
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.10"}
  "rel"
  "conf-sqlite3"
  "base"
  "stdio"
  "bos"
  "fpath"
  "ptime"
  "decimal" {>= "1.0.2"}
  "ppx_sexp_conv"
  "ppx_compare"
  "ppx_let"
  "cmdliner" {>= "1.3.0"}
  "yojson"
  "xmlm"
  "re"
  "digestif"
  "csv" {>= "2.4"}
  "hledger"
  "alcotest" {with-test}
  "zarith" {with-test}
]
pin-depends: [
  ["hledger.dev" "git+https://github.com/vbmithr/ocaml-hledger.git#cad809fa47876142cfdf361bde2a2e506ebdadad"]
  ["rel.dev" "git+https://github.com/dbuenzli/rel.git#f196804c51031870327ecc482d0b97f052941081"]
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
  ["dune" "runtest" "-p" name "-j" jobs] {with-test}
]
