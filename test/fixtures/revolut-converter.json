{
  "format": "fin-csv-converter",
  "version": 1,
  "institution": "revolut",
  "institution_type": "bank",
  "header": [
    "Type",
    "Product",
    "Started Date",
    "Completed Date",
    "Description",
    "Amount",
    "Fee",
    "Currency",
    "State",
    "Balance"
  ],
  "account": {
    "id": "current-{Currency}",
    "bank": "revolut",
    "number": "personal",
    "type": "current-{Currency}",
    "currency": {
      "fiat": "Currency"
    }
  },
  "occurred": {
    "column": "Completed Date",
    "fallback": "Started Date",
    "layout": "iso-datetime"
  },
  "cases": [
    {
      "when": [
        {
          "column": "State",
          "in": [
            "COMPLETED"
          ]
        }
      ],
      "movements": [
        {
          "role": "primary",
          "quantity": {
            "column": "Amount",
            "minus": "Fee"
          },
          "commodity": {
            "fiat": "Currency"
          }
        }
      ],
      "fee": {
        "column": "Fee"
      }
    }
  ],
  "reported": {
    "quantity": "Amount",
    "symbol": "Currency"
  },
  "descriptions": [
    "Description"
  ],
  "balance_after": "Balance",
  "require": [
    {
      "column": "Product",
      "in": [
        "Current"
      ]
    },
    {
      "column": "State",
      "in": [
        "COMPLETED",
        "REVERTED"
      ]
    },
    {
      "column": "Started Date",
      "matches": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$"
    },
    {
      "column": "Amount",
      "matches": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    {
      "column": "Fee",
      "matches": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    {
      "when": [
        {
          "column": "State",
          "in": [
            "COMPLETED"
          ]
        }
      ],
      "column": "Type",
      "filled": true
    },
    {
      "when": [
        {
          "column": "State",
          "in": [
            "COMPLETED"
          ]
        }
      ],
      "column": "Completed Date",
      "matches": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$"
    },
    {
      "when": [
        {
          "column": "State",
          "in": [
            "COMPLETED"
          ]
        }
      ],
      "column": "Completed Date",
      "not_before": "Started Date"
    },
    {
      "when": [
        {
          "column": "State",
          "in": [
            "COMPLETED"
          ]
        }
      ],
      "column": "Balance",
      "matches": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    {
      "when": [
        {
          "column": "State",
          "in": [
            "REVERTED"
          ]
        }
      ],
      "column": "Completed Date",
      "filled": false
    },
    {
      "when": [
        {
          "column": "State",
          "in": [
            "REVERTED"
          ]
        }
      ],
      "column": "Balance",
      "filled": false
    }
  ]
}
