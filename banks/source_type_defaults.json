[
  {
    "version": 1,
    "institution": "boursobank",
    "rules": [
      {"description": "^(?:Relevé différé Carte |Relev\\{ diff\\{r\\{ Carte ).+", "account_type": null, "case_sensitive": true, "type": "card-settlement"},
      {"description": "^(?:PAIEMENT\\s+CARTE|AVOIR)(?:\\s|$)", "account_type": null, "case_sensitive": false, "type": "card"},
      {"description": "^CARTE(?:\\s|$)", "account_type": "CREDITCRD", "case_sensitive": false, "type": "card"},
      {"description": "^(?:VIR|VIREMENT)(?:\\s|$)", "account_type": null, "case_sensitive": false, "type": "transfer"},
      {"description": "^(?:PRLV|PRELEVEMENT)(?:\\s|$)", "account_type": null, "case_sensitive": false, "type": "direct-debit"},
      {"description": "^(?:RETRAIT|ANNUL\\s+RETRAIT\\s+DAB)(?:\\s|$)", "account_type": null, "case_sensitive": false, "type": "withdrawal"},
      {"description": "^(?:\\*INTERETS|INTERETS|\\*INTÉRÊTS|INTÉRÊTS|\\*INTER\\.BRUTS|\\*INT\\s+DEB)(?:\\s|$)", "account_type": null, "case_sensitive": false, "type": "interest"},
      {"description": "^REM\\s+CHQ(?:\\s|$)", "account_type": null, "case_sensitive": false, "type": "deposit"},
      {"description": "^CHQ\\.(?:\\s|$)", "account_type": null, "case_sensitive": false, "type": "cheque"},
      {"description": "^(?:\\*CION\\s+CB|\\*FRAIS\\s+CB|\\*RETROC\\s+\\*FRAIS\\s+CB)(?:\\s|$)", "account_type": null, "case_sensitive": false, "type": "fee"}
    ]
  }
]
