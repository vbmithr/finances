; The persistence layer: schema, ingest, review and projection over SQLite.
; It reaches banks only through the registry it is given.

(library
 (name finances_store)
 (public_name finances.store)
 (private_modules db_schema sqlite_schema sql)
 (foreign_stubs
  (language c)
  (names sqlite_decimal sqlite_decimal_stubs)
  (flags
   (:standard -DSQLITE_CORE)))
 (flags
  (:standard -open Finances_core -open Finances))
 (libraries
  finances
  finances.core
  base
  stdio
  bos
  fpath
  decimal
  ptime
  rel
  rel.sqlite3
  jsont
  re
  digestif
  iban
  iso4217)
 (preprocess
  (pps ppx_sexp_conv ppx_compare ppx_let)))

; Queries and views live in sql/, by subject, one per file, read by the generated Sql
; module; sql/views/ holds the views every connection creates.

(rule
 (target sql.ml)
 (deps
  (glob_files_rec sql/*.sql))
 (action
  (with-stdout-to
   %{target}
   (run gen/embed_sql.exe %{deps}))))
